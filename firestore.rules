rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function gestor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['zhenburger@gmail.com'];
    }

    match /menu/{id} {
      allow read: if true;
      allow write: if gestor();
    }

    match /cfg/{id} {
      allow read: if true;
      allow write: if gestor();
    }

    match /cupons/{id} {
      allow get: if true;
      allow list, write: if gestor();
    }

    match /couriers/{id} {
      allow read, write: if gestor();
    }

    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow delete: if false;
    }

    match /orders/{id} {
      allow get: if gestor() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow list: if gestor();
      allow update, delete: if gestor();

      allow create: if gestor() || validNewOrder(request.resource.data, id);

      function validNewOrder(d, id) {
        return request.auth != null
          && d.ownerUid == request.auth.uid
          && d.id == id
          && d.status == 'novo'
          && d.pago == false
          && d.n == 0
          && d.courier == ''
          && d.tipo in ['entrega', 'retirada']
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 80
          && d.tel is string && d.tel.size() >= 8 && d.tel.size() <= 15
          && d.itens is list && d.itens.size() > 0 && d.itens.size() <= 50
          && d.total is number && d.subtotal is number
          && d.desconto is number && d.taxa is number
          && d.desconto >= 0 && d.desconto <= d.subtotal && d.taxa >= 0
          && math.abs(d.total - (d.subtotal - d.desconto + d.taxa)) < 0.01;
      }
    }

    match /audit/{aid} {
      allow read: if gestor();
      allow update, delete: if false;

      allow create: if gestor() || (
        request.auth != null
        && request.resource.data.action == 'pedido_criado'
        && request.resource.data.n == 0
        && request.resource.data.prev == '0'
        && request.resource.data.actor == 'cliente'
        && aid == request.resource.data.orderId + '_0'
      );
    }
  }
}